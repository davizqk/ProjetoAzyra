@baseUrl = http://localhost:5080
@token = COLE_AQUI_O_JWT_DO_LOGIN

### Ping publico
GET {{baseUrl}}/api/saude

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "admin@teste.local", "senha": "SENHA_CRIADA_NO_BOOTSTRAP" }

### Modelos (autenticado)
GET {{baseUrl}}/api/admin/modelos
Authorization: Bearer {{token}}

### Turmas (autenticado)
GET {{baseUrl}}/api/admin/turmas
Authorization: Bearer {{token}}

### Exemplo de criacao de turma
POST {{baseUrl}}/api/admin/turmas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nome": "1A", "idModelo": 1, "idPeriodo": 1, "anoLetivo": 2026 }

### Atrasos por turma
GET {{baseUrl}}/api/turmas/1/atrasos?pagina=1&tamanho=10
Authorization: Bearer {{token}}

### Identificar aluno (CPF de teste cadastrado no banco)
POST {{baseUrl}}/api/registro/identificar
Content-Type: application/json

{ "cpf": "INSIRA_UM_CPF_VALIDO_DE_TESTE" }

### Confirmar registro (token temporario devolvido pela identificacao)
POST {{baseUrl}}/api/registro/confirmar
Content-Type: application/json

{ "tokenConfirmacao": "INSIRA_TOKEN_RECEBIDO" }

### Listar calendario geral
GET {{baseUrl}}/api/admin/calendario?ano=2026
Authorization: Bearer {{token}}

### Reconfigurar calendario (preservando feriados manuais)
PUT {{baseUrl}}/api/admin/calendario/reconfigurar
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inicio": "2026-01-01",
  "fim": "2026-12-31",
  "diasSemanaLetivos": [1, 2, 3, 4, 5, 6],
  "preservarExcecoes": true
}

### Editar um dia sem historico (exemplo de feriado)
PUT {{baseUrl}}/api/admin/calendario/2026-12-25
Authorization: Bearer {{token}}
Content-Type: application/json

{ "diaLetivo": false, "descricao": "Natal" }

### Excluir um dia (somente banco de teste)
DELETE {{baseUrl}}/api/admin/calendario/2027-01-01
Authorization: Bearer {{token}}

### Excluir ano (somente banco de teste, sem historico)
DELETE {{baseUrl}}/api/admin/calendario/ano/2027?confirmar=true
Authorization: Bearer {{token}}


### Cadastrar aluno (sem numero de matricula)
POST {{baseUrl}}/api/admin/alunos
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nome": "Aluno Teste", "cpf": "INSIRA_UM_CPF_VALIDO_DE_TESTE" }

### Consultar alunos (sem numero de matricula)
GET {{baseUrl}}/api/admin/alunos
Authorization: Bearer {{token}}

### Vincular aluno a turma (matricula como vinculo, nao como numero)
POST {{baseUrl}}/api/admin/matriculas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "idAluno": 1, "idTurma": 1, "dataMatricula": "2026-11-24", "dataSaida": null }


### Reconfigurar calendário removendo dias não selecionados (admin)
PUT http://localhost:5080/api/admin/calendario/reconfigurar
Authorization: Bearer {{token}}
Content-Type: application/json

{"inicio":"2026-01-01","fim":"2026-12-31","diasSemanaLetivos":[1,2,3,4,5,6],"preservarExcecoes":true,"removerDiasNaoLetivos":true}


### Listar horários de uma turma (troque o ID)
GET {{baseUrl}}/api/admin/horarios?turmaId=1
Authorization: Bearer {{token}}

### Excluir horário cadastrado incorretamente (troque pelo idHorario real, não idTurma)
DELETE {{baseUrl}}/api/admin/horarios/123
Authorization: Bearer {{token}}
